# Copy to .env and fill in — or skip the copy entirely and run `make infra-init`,
# which creates .env and generates the three GARAGE_* secrets below if absent.
# .env is gitignored; never commit real values.

# --- Garage (S3-compatible blob store) ---
GARAGE_S3_PORT=3900
GARAGE_RPC_SECRET=generated-by-make-infra-init
GARAGE_DEFAULT_ACCESS_KEY=generated-by-make-infra-init
GARAGE_DEFAULT_SECRET_KEY=generated-by-make-infra-init
GARAGE_DEFAULT_BUCKET=drive-blobs

# --- Postgres ---
POSTGRES_PORT=55432
POSTGRES_USER=drive
POSTGRES_PASSWORD=drive
POSTGRES_DB=drive

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# --- drive server ---
DRIVE_ADDR=:8080
DRIVE_DB_DSN=postgres://drive:drive@localhost:55432/drive?sslmode=disable
DRIVE_S3_ENDPOINT=http://localhost:3900
DRIVE_S3_BUCKET=drive-blobs
# DRIVE_S3_ACCESS_KEY / DRIVE_S3_SECRET_KEY must equal GARAGE_DEFAULT_ACCESS_KEY /
# GARAGE_DEFAULT_SECRET_KEY above — the server authenticates to Garage with them.
DRIVE_S3_ACCESS_KEY=generated-by-make-infra-init
DRIVE_S3_SECRET_KEY=generated-by-make-infra-init
# Signing region. Must equal the store's own region: "garage" locally (default).
DRIVE_S3_REGION=garage
DRIVE_SMTP_ADDR=localhost:1025
DRIVE_MAILPIT_API=http://localhost:8025
# Mail path: leave DRIVE_RESEND_KEY empty and mail goes over SMTP to Mailpit.
# Set it and mail goes over Resend's HTTP API instead, DRIVE_SMTP_ADDR is no
# longer required, and the boot-time SMTP probe is skipped — which is what a
# deployment on a host that blocks outbound SMTP needs. DRIVE_MAIL_FROM must
# then be an address on a domain verified with Resend.
DRIVE_RESEND_KEY=
DRIVE_MAIL_FROM=
DRIVE_BASE_URL=http://localhost:8080
DRIVE_PART_SIZE=100MiB
DRIVE_PRESIGN_TTL=1h
DRIVE_TOKEN_PRESIGN_TTL=10m
DRIVE_LOG_LEVEL=debug
# Abuse controls. Both fall back to their built-in defaults when unset or 0 —
# there is no value that disables them.
# DRIVE_ARGON2_LIMIT: concurrent Argon2 hashes/verifies (default 4, ~19 MiB
# each). Lower it on a small container; it is a memory ceiling first.
DRIVE_ARGON2_LIMIT=4
# DRIVE_AUTH_RATE_PER_MIN: /api/auth requests per minute per client address,
# burst twice that (default 10).
DRIVE_AUTH_RATE_PER_MIN=10
# Volume caps. 0 means no cap, which is the local and test setting — the test
# battery uploads multi-GB files on purpose.
# DRIVE_MAX_FILE_SIZE: largest single upload (prod: 2GiB).
DRIVE_MAX_FILE_SIZE=0
# DRIVE_STORAGE_CAP: total bytes the service will hold, published plus in
# flight. This is the object store's spend control — the store itself has none.
DRIVE_STORAGE_CAP=0
# DRIVE_USER_QUOTA: bytes one account may hold, trashed files included.
DRIVE_USER_QUOTA=0
# DRIVE_SIGNUP_MODE: open | invite | closed. invite behaves as closed until an
# invite system exists.
DRIVE_SIGNUP_MODE=open
# DRIVE_EMAIL_DAILY_CAP: messages the whole service may send in a rolling day.
# 0 means no budget; the default is 80, under Resend's free 100/day.
DRIVE_EMAIL_DAILY_CAP=80
# GOMEMLIMIT is a Go runtime variable, not one this server reads. Go's collector
# is heap-target driven, so a container that bills for RAM wants a soft ceiling
# well under its limit — e.g. GOMEMLIMIT=400MiB on a 512 MiB instance.
