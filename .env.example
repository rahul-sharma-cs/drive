# Copy to .env and fill in — or skip the copy entirely and run `make infra-init`,
# which creates .env and generates the three GARAGE_* secrets below if absent.
# .env is gitignored; never commit real values.

# --- Garage (S3-compatible blob store) ---
GARAGE_S3_PORT=3900
GARAGE_RPC_SECRET=generated-by-make-infra-init
GARAGE_DEFAULT_ACCESS_KEY=generated-by-make-infra-init
GARAGE_DEFAULT_SECRET_KEY=generated-by-make-infra-init
GARAGE_DEFAULT_BUCKET=drive-blobs

# --- Postgres ---
POSTGRES_PORT=55432
POSTGRES_USER=drive
POSTGRES_PASSWORD=drive
POSTGRES_DB=drive

# --- Mailpit ---
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# --- drive server ---
DRIVE_ADDR=:8080
DRIVE_DB_DSN=postgres://drive:drive@localhost:55432/drive?sslmode=disable
DRIVE_S3_ENDPOINT=http://localhost:3900
DRIVE_S3_BUCKET=drive-blobs
# DRIVE_S3_ACCESS_KEY / DRIVE_S3_SECRET_KEY must equal GARAGE_DEFAULT_ACCESS_KEY /
# GARAGE_DEFAULT_SECRET_KEY above — the server authenticates to Garage with them.
DRIVE_S3_ACCESS_KEY=generated-by-make-infra-init
DRIVE_S3_SECRET_KEY=generated-by-make-infra-init
# Signing region. Must equal the store's own region: "garage" locally (default).
DRIVE_S3_REGION=garage
DRIVE_SMTP_ADDR=localhost:1025
DRIVE_MAILPIT_API=http://localhost:8025
# Mail path: leave DRIVE_RESEND_KEY empty and mail goes over SMTP to Mailpit.
# Set it and mail goes over Resend's HTTP API instead, DRIVE_SMTP_ADDR is no
# longer required, and the boot-time SMTP probe is skipped — which is what a
# deployment on a host that blocks outbound SMTP needs. DRIVE_MAIL_FROM must
# then be an address on a domain verified with Resend.
DRIVE_RESEND_KEY=
DRIVE_MAIL_FROM=
DRIVE_BASE_URL=http://localhost:8080
DRIVE_PART_SIZE=100MiB
DRIVE_PRESIGN_TTL=1h
DRIVE_TOKEN_PRESIGN_TTL=10m
DRIVE_LOG_LEVEL=debug
# Abuse controls. All four fall back to their built-in defaults when unset or
# 0 — there is no value that disables them.
# DRIVE_ARGON2_LIMIT: concurrent Argon2 hashes/verifies (default 4, ~19 MiB
# each). Lower it on a small container; it is a memory ceiling first.
DRIVE_ARGON2_LIMIT=4
# DRIVE_AUTH_RATE_PER_MIN: unauthenticated /api/auth requests per minute per
# client address, burst twice that (default 10). The signed-in half of /api/auth
# is not bucketed — the session is a better identity than a shared NAT address —
# except POST /auth/password, which reaches Argon2.
DRIVE_AUTH_RATE_PER_MIN=10
# DRIVE_MAIL_RATE_PER_HOUR: password-reset + resend-verification requests per
# hour per client address, no extra burst (default 5). These are the two
# endpoints where the caller names somebody else's inbox, so this bounds how
# fast one address can spend other people's send budgets.
DRIVE_MAIL_RATE_PER_HOUR=5
# DRIVE_SHARE_RATE_PER_MIN: public share-link requests (/api/s/...) per minute
# per client address, burst twice that (default 60). Its own allowance because
# a share page load is three requests; the password check on a share sits in
# the auth bucket instead, since it reaches Argon2.
DRIVE_SHARE_RATE_PER_MIN=60
# Volume caps. 0 means no cap, which is the local and test setting — the test
# battery uploads multi-GB files on purpose. Sizes take a plain byte count, a
# binary suffix (100MiB) or a decimal one (2GB); quote these three in decimal,
# since they are the numbers a user is shown.
# DRIVE_MAX_FILE_SIZE: largest single upload (prod: 2GB).
DRIVE_MAX_FILE_SIZE=0
# DRIVE_STORAGE_CAP: total bytes the service will hold, published plus in
# flight. This is the object store's spend control — the store itself has none.
DRIVE_STORAGE_CAP=0
# DRIVE_USER_QUOTA: bytes one account may hold, trashed files included.
DRIVE_USER_QUOTA=0
# DRIVE_SIGNUP_MODE: open | invite | closed. invite behaves as closed until an
# invite system exists.
DRIVE_SIGNUP_MODE=open
# Sign in with Google. Both empty — which is what a fresh clone gets — means the
# feature is off: GET /api/auth/providers answers {"google":false} and the
# sign-in screens never render the button. Fill both in with a Google Cloud
# OAuth **Web application** client whose authorized redirect URI is exactly
# DRIVE_BASE_URL + /api/auth/google/callback, with no trailing slash and no
# JavaScript origins (no Google JS ships in the browser). A half-filled pair is
# refused at boot rather than at somebody's first click.
DRIVE_GOOGLE_CLIENT_ID=
DRIVE_GOOGLE_CLIENT_SECRET=
# DRIVE_GOOGLE_ISSUER exists only so the test suite and `make e2e` can point at
# a local fake provider. Leave it unset: the real default is in the server's
# config package, and it belongs in exactly one place.
# DRIVE_EMAIL_DAILY_CAP: messages the whole service may send in a rolling day.
# 0 means no budget. The default is 45 — half a 100/day vendor allowance, not
# all of it, because the window is anchored to its first event rather than to a
# calendar day, so two full windows can land inside one vendor day.
DRIVE_EMAIL_DAILY_CAP=45
# GOMEMLIMIT is a Go runtime variable, not one this server reads. Go's collector
# is heap-target driven, so a container that bills for RAM wants a soft ceiling
# well under its limit — e.g. GOMEMLIMIT=400MiB on a 512 MiB instance.
