# drive-test stack — committed on purpose (PLAN.md §Fixed choices).
# Throwaway constants only. Never reuse any of these values for a real .env.
# Used as: docker compose -p drive-test --env-file .env.test up -d

# --- Garage (S3-compatible blob store), rebound port ---
GARAGE_S3_PORT=3910
# throwaway test-stack secret, intentionally committed
GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
GARAGE_DEFAULT_ACCESS_KEY=drivetestkey0001
GARAGE_DEFAULT_SECRET_KEY=drivetestsecretkey0001
GARAGE_DEFAULT_BUCKET=drive-blobs

# --- Postgres, rebound port ---
POSTGRES_PORT=55433
POSTGRES_USER=drive
POSTGRES_PASSWORD=drive
POSTGRES_DB=drive

# --- Mailpit, rebound ports ---
MAILPIT_SMTP_PORT=1026
MAILPIT_HTTP_PORT=8026

# --- drive server, pointed at the rebound test stack ---
DRIVE_ADDR=:8081
DRIVE_DB_DSN=postgres://drive:drive@localhost:55433/drive?sslmode=disable
DRIVE_S3_ENDPOINT=http://localhost:3910
DRIVE_S3_BUCKET=drive-blobs
DRIVE_S3_ACCESS_KEY=drivetestkey0001
DRIVE_S3_SECRET_KEY=drivetestsecretkey0001
DRIVE_SMTP_ADDR=localhost:1026
DRIVE_MAILPIT_API=http://localhost:8026
DRIVE_BASE_URL=http://localhost:8081
DRIVE_PART_SIZE=10MiB
DRIVE_LOG_LEVEL=debug
# The whole suite runs from one address against one server, so the per-IP auth
# bucket would refuse it long before any test finished. The middleware still
# runs on every request -- only the allowance is raised; the bucket's own
# behaviour is tested deterministically in internal/api with an injected clock.
DRIVE_AUTH_RATE_PER_MIN=100000
# No service-wide mail budget against Mailpit, which has no vendor quota to
# protect. The cap itself is tested in internal/api with an explicit config.
DRIVE_EMAIL_DAILY_CAP=0
# The signing region must match the store: garage locally, auto on R2. It has
# no built-in default, so an environment that forgets it fails at boot rather
# than at the first upload.
DRIVE_S3_REGION=garage
